{
  "name": "tervina-warranty",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build && node scripts/pages-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:data": "node tools/gen-data.mjs",
    "gen:warranty": "node tools/resolve-warranty.mjs",
    "gen:apply": "node tools/build-apply-all.mjs",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "client-zip": "^2.5.1",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  }
